PORT=5000
HOST=127.0.0.1
NODE_ENV=development
# College demo only. Requires NODE_ENV=development; otherwise signup stays Member-only.
DEMO_ROLE_REGISTRATION=false
MONGODB_URI=mongodb://127.0.0.1:27017/fittrack
# Generate your own random 64-character (or longer) value. Never commit the real secret.
JWT_SECRET=
# Optional phone push. Generate a VAPID pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
